# Application
PORT=3000
NODE_ENV=development
APP_NAME=Ehte
CORS_CREDENTIALS=true
APP_DEBUG=false

APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:5173

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=Ehte

# PostgreSQL
POSTGRES_DB=ehte_db
POSTGRES_USER=ehte_user
POSTGRES_PASSWORD=your-postgres-password

DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require
DIRECT_URL=postgresql://username:password@host:5432/database?sslmode=require

# Swagger
SWAGGER_ENABLED=true
SWAGGER_USER=ehte-admin
SWAGGER_PASSWORD=your-swagger-password

# JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=24h

JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Optional
# JWT_INVITE_SECRET=your-invite-secret

# OTP
OTP_EXPIRES_IN_MINUTES=2
OTP_RESEND_COOLDOWN_SECONDS=60

# Security — Login Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Security — Encryption
ENCRYPTION_KEY=your-64-character-hex-encryption-key
ENCRYPTION_IV=your-32-character-hex-encryption-iv

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# AfroMessage
AFROMESSAGE_URL=https://api.afromessage.com/api/send
AFROMESSAGE_TOKEN=your-afromessage-token
AFROMESSAGE_IDENTIFIER_ID=your-afromessage-identifier-id
AFROMESSAGE_SENDER_NAME=your-sender-name

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9010

# Docker internal MinIO connection
MINIO_ENDPOINT_DOCKER=minio
MINIO_PORT_DOCKER=9000

MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=ehte-media
MINIO_PUBLIC_URL=http://localhost:9010
DURATION_OF_PRE_SIGNED_DOCUMENT=86400

# Admin Seed
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Ehte System Admin
ADMIN_PASSWORD=your-strong-admin-password

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=20

# Database Migrations
RUN_MIGRATIONS=true

# Media Uploads
MEDIA_MAX_FILE_SIZE=10485760
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,video/mp4,audio/mpeg,audio/wav

# Feature Flags
SUPPORT_CURRENCY=ETB
SUPPORT_ENABLED=true
MISSING_PERSONS_ENABLED=true
VICTIM_SUPPORT_ENABLED=true