
# Ehte — Environment Configuration Example

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────

PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────

DATABASE_URL=postgresql://ehte_user:ehte_pass@localhost:5432/ehte_db

# ─────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────

JWT_SECRET=change-this-development-jwt-secret
JWT_EXPIRES_IN=24
JWT_REFRESH_SECRET=change-this-development-refresh-secret
JWT_REFRESH_EXPIRES_IN=48

# ─────────────────────────────────────────────
# OTP
# ─────────────────────────────────────────────

OTP_EXPIRES_IN_MINUTES=2

# ─────────────────────────────────────────────
# SMS — AfroMessage
# ─────────────────────────────────────────────

SMS_AFRO_MESSAGE_API_URL=https://api.afromessage.com/api/send
SMS_AFRO_MESSAGE_API_KEY=your-afromessage-api-key
SMS_AFRO_MESSAGE_SENDER_NAME=Ehte

# ─────────────────────────────────────────────
# File / Media Storage — MinIO
# ─────────────────────────────────────────────

MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=ehte-media
MINIO_PUBLIC_URL=http://localhost:9010
MINIO_BUCKET=ehte-files
DURATION_OF_PRE_SIGNED_DOCUMENT=86400

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────

CORS_ORIGIN=http://localhost:3000
