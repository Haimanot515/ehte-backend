# Ehte — Environment Configuration Example

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────

PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
CORS_CREDENTIALS=true
APP_DEBUG=false

# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────

POSTGRES_DB=ehte_db
POSTGRES_USER=ehte_user
POSTGRES_PASSWORD=your-postgres-password

DATABASE_URL=postgresql://ehte_user:your-postgres-password@localhost:5432/ehte_db

# ─────────────────────────────────────────────
# Swagger / OpenAPI
# ─────────────────────────────────────────────

SWAGGER_ENABLED=true
SWAGGER_USER=your-swagger-username
SWAGGER_PASSWORD=your-swagger-password

# ─────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────

JWT_SECRET=change-this-development-jwt-secret
JWT_EXPIRES_IN=24h

JWT_REFRESH_SECRET=change-this-development-refresh-secret
JWT_REFRESH_EXPIRES_IN=48h

# ─────────────────────────────────────────────
# OTP
# ─────────────────────────────────────────────

OTP_EXPIRES_IN_MINUTES=2
OTP_RESEND_COOLDOWN_SECONDS=60

# ─────────────────────────────────────────────
# Security — Login Lockout
# ─────────────────────────────────────────────

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ─────────────────────────────────────────────
# Security — Encryption
# ─────────────────────────────────────────────

ENCRYPTION_KEY=your-encryption-key
ENCRYPTION_IV=your-encryption-iv

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────

CORS_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=20

# ─────────────────────────────────────────────
# Database Migrations
# ─────────────────────────────────────────────

RUN_MIGRATIONS=true

# ─────────────────────────────────────────────
# SMS — AfroMessage
# ─────────────────────────────────────────────

AFROMESSAGE_URL=https://api.afromessage.com/api/send
AFROMESSAGE_TOKEN=your-afromessage-api-token
AFROMESSAGE_IDENTIFIER_ID=your-afromessage-identifier-id
AFROMESSAGE_SENDER_NAME=Ehte

# ─────────────────────────────────────────────
# File / Media Storage — MinIO
# ─────────────────────────────────────────────

# Local development

MINIO_ENDPOINT=localhost
MINIO_PORT=9010

# Docker internal connection

MINIO_ENDPOINT_DOCKER=minio
MINIO_PORT_DOCKER=9000

MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key

MINIO_BUCKET=ehte-files
MINIO_BUCKET_NAME=ehte-media

MINIO_PUBLIC_URL=http://localhost:9010

DURATION_OF_PRE_SIGNED_DOCUMENT=86400

# ─────────────────────────────────────────────
# Admin
# ─────────────────────────────────────────────

ADMIN_PHONE=your-admin-phone
ADMIN_NAME=Ehte System Admin
ADMIN_PASSWORD=your-secure-admin-password