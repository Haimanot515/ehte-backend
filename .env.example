# =========================================================
# EHTE BACKEND - ENVIRONMENT VARIABLES
# =========================================================

# Application
PORT=3000
NODE_ENV=development
APP_NAME=Ehte
CORS_CREDENTIALS=true
APP_DEBUG=false

APP_URL=https://api.eheta.dev.pitrontech.et
ADMIN_APP_URL=https://admin.eheta.dev.pitrontech.et


# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=Ehte


# PostgreSQL
POSTGRES_DB=ehte_db
POSTGRES_USER=ehte_user
POSTGRES_PASSWORD=change-this-password

DATABASE_URL=postgresql://username:password@host/database?sslmode=require
DIRECT_URL=postgresql://username:password@host/database?sslmode=require


# Swagger
SWAGGER_ENABLED=true
SWAGGER_USER=ehte-admin
SWAGGER_PASSWORD=change-this-swagger-password


# JWT
# Generate with: openssl rand -base64 64
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=24h

JWT_REFRESH_SECRET=change-this-to-another-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Optional
# JWT_INVITE_SECRET=change-this-to-a-random-secret


# OTP
OTP_EXPIRES_IN_MINUTES=2
OTP_RESEND_COOLDOWN_SECONDS=60


# Security - Login Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15


# Security - Encryption
# Generate with:
# openssl rand -hex 32
# openssl rand -hex 16
ENCRYPTION_KEY=change-this-to-a-64-character-hex-key
ENCRYPTION_IV=change-this-to-a-32-character-hex-iv


# CORS
CORS_ORIGIN=https://admin.eheta.dev.pitrontech.et



# MinIO — use the existing shared-minio on ecs-a447 (host port 9100).
# Do NOT start another MinIO container. From inside Docker, the host is
# host.docker.internal (compose extra_hosts). Credentials come from the
# Azure secure file ehte-dev.env, not from this example.
MINIO_ENDPOINT=host.docker.internal
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-this-shared-minio-access-key
MINIO_SECRET_KEY=change-this-shared-minio-secret-key
MINIO_BUCKET_NAME=ehte-media
MINIO_PUBLIC_URL=https://minio.eheta.dev.pitrontech.et

DURATION_OF_PRE_SIGNED_DOCUMENT=86400


# Admin Seed
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Ehte System Admin
ADMIN_PASSWORD=change-this-admin-password


# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=20


# Database Migrations
RUN_MIGRATIONS=true


# Media Uploads
MEDIA_MAX_FILE_SIZE=10485760

MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,video/mp4,audio/mpeg,audio/wav,application/pdf


# Content Submission Limits / Retention
# Shared defaults for:
# Post, Report, Missing Person,
# Information Submission, Victim Profile

CONTENT_MAX_PENDING_PER_USER=5
CONTENT_CREATE_RATE_LIMIT_WINDOW_SECONDS=60
CONTENT_DRAFT_TTL_DAYS=30
CONTENT_REJECTED_RETENTION_DAYS=90
CONTENT_STALE_PENDING_HOURS=48


# Content Upload Limits
CONTENT_MAX_PHOTOS=5
CONTENT_MAX_VIDEOS=1
CONTENT_MAX_OTHER_FILES=2
CONTENT_MAX_TOTAL_UPLOAD_BYTES=52428800


# Automatic Rejection / Flagging
CONTENT_AUTO_FLAG_REJECTION_COUNT=3
CONTENT_AUTO_FLAG_WINDOW_DAYS=7


# Victim Profile
# Child-involving cases use a shorter stale threshold.
PROFILE_STALE_CHILD_HOURS=12


# Feature Flags
SUPPORT_CURRENCY=ETB
SUPPORT_ENABLED=true
MISSING_PERSONS_ENABLED=true
VICTIM_SUPPORT_ENABLED=true
# SMS / SendET
SENDET_URL=https://api.send.et
SENDET_TOKEN=
SENDET_SENDER_NAME="PITRON TECH"
SENDET_TIMEOUT_MS=10000