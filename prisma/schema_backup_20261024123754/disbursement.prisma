enum DisbursementStatus {
  CREATED
  SUBMITTED
  PAID
  FAILED
  UNKNOWN
}

model Disbursement {
  id              String             @id @default(uuid())
  victimProfileId String
  status          DisbursementStatus @default(CREATED)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("ETB")

  reference        String   @unique
  chapaTransferRef String?  @unique
  transferFee      Decimal? @db.Decimal(14, 2)
  failureReason    String?

  destinationSnapshot Json

  submittedAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  victimProfile VictimProfile @relation(fields: [victimProfileId], references: [id], onDelete: Restrict)

  @@index([victimProfileId, status])
  @@index([status, updatedAt])
  @@map("disbursements")
}