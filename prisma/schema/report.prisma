model Report {
  id            String            @id @default(uuid())
  userId        String?
  caseReference String            @unique
  description   String
  location      String?
  incidentAt    DateTime?
  channel       SubmissionChannel @default(APP)
  photo         String[]
  video         String[]
  audio         String[]
  pdf           String[]
  document      String[]
  other         String[]
  status        ReportStatus      @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  assignedToId  String?
  category      ReportCategory

  // Per-user duplicate-submission protection, NULL keys never conflict
  idempotencyKey String?

  mediaTotalBytes Int @default(0)

  // Set when the owner is suspended, status is deliberately left unchanged
  ownerSuspendedAt DateTime?

  assignedTo          User?                      @relation("ReportAssignee", fields: [assignedToId], references: [id])
  user                User?                      @relation("ReportReporter", fields: [userId], references: [id], onDelete: Cascade)
  informationRequests ReportInformationRequest[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([status])
  @@index([assignedToId])
  @@index([caseReference])
  @@index([category])
  @@index([channel])
  @@index([status, createdAt])
  @@map("report")
}

model ReportInformationRequest {
  id              String                   @id @default(uuid())
  reportId        String
  requestedById   String
  message         String
  status          InformationRequestStatus @default(PENDING)
  responseMessage String?
  responseFiles   String[]                 @default([])
  respondedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  report          Report                   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  requestedBy     User                     @relation("InfoRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([requestedById])
  @@index([status])
  @@map("report_information_request")
}

enum ReportCategory {
  HARASSMENT
  ABUSE
  FRAUD
  THREAT
  DISCRIMINATION
  SAFETY_CONCERN
  OTHER
}

enum ReportStatus {
  PENDING
  RECEIVED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  ESCALATED
  CLOSED
  UNABLE_TO_VERIFY
  REJECTED
}

enum InformationRequestStatus {
  PENDING
  RESPONDED
}
