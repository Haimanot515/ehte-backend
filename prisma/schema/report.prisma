// ─────────────────────────────────────────────
// EHTE FEATURES — Report
// ─────────────────────────────────────────────

enum ReportStatus {
  PENDING
  RECEIVED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  ESCALATED
  CLOSED
  UNABLE_TO_VERIFY
  REJECTED
}

model Report {
  id     String @id @default(uuid())
  userId String

  caseReference String @unique

  category    String
  description String

  location   String?
  incidentAt DateTime?

  photo    String[]
  video    String[]
  audio    String[]
  pdf      String[]
  document String[]
  other    String[]

  status ReportStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([caseReference])
  @@map("report")
}
