model AuditLog {
  id        String    @id @default(uuid())
  userId    String?
  actorType ActorType
  action    String
  entity    String
  entityId  String?
  diff      Json?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([action])
  @@map("audit_log")
}

enum ActorType {
  USER
  ADMIN
  SUPER_ADMIN
  SYSTEM
}
