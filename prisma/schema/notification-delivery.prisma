// Notification model needs the matching relation fields (broadcastId, broadcast, deliveries)

model NotificationPreference {
  id              String           @id @default(uuid())
  userId          String
  type            NotificationType
  email           Boolean?
  sms             Boolean?
  push            Boolean?
  quietHoursStart String?
  quietHoursEnd   String?
  timezone        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("notification_preference")
}

// Statuses are plain strings so the queue claim can use simple raw SQL
model NotificationDelivery {
  id             String    @id @default(uuid())
  notificationId String
  userId         String
  channel        String
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([channel, status])
  @@map("notification_delivery")
}

// FIX: was missing a @relation to User — userId was a bare scalar with no FK,
// so DeviceToken rows were never cascade-deleted and could outlive their user.
model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_token")
}

model NotificationBroadcast {
  id             String               @id @default(uuid())
  createdById    String?
  audience       String
  type           NotificationType
  title          String
  body           String
  priority       NotificationPriority @default(NORMAL)
  templateId     String?
  status         String               @default("SCHEDULED")
  scheduledAt    DateTime             @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  recipientCount Int                  @default(0)
  attempts       Int                  @default(0)
  error          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt

  // Two-person approval for large broadcasts (NF-31, NF-32).
  // Extra statuses used with these fields: AWAITING_APPROVAL, REJECTED.
  requiresApproval Boolean   @default(false)
  approvedById     String?
  approvedAt       DateTime?
  rejectedById     String?
  rejectedAt       DateTime?
  rejectionReason  String?

  // Halting a broadcast that is already sending (NF-33). Extra status: STOPPED.
  stopRequestedAt   DateTime?
  stopRequestedById String?
  stoppedAt         DateTime?

  notifications Notification[]
  createdBy     User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  template      NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([createdById, createdAt])
  @@map("notification_broadcast")
}

model NotificationTemplate {
  id          String           @id @default(uuid())
  type        NotificationType
  language    String
  title       String
  body        String
  isActive    Boolean          @default(true)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  // Soft retire (NF-24) and bring back (NF-25)
  retiredAt   DateTime?
  retiredById String?

  broadcasts NotificationBroadcast[]

  @@unique([type, language])
  @@map("notification_template")
}

model NotificationIdempotencyKey {
  id        String   @id @default(uuid())
  actorId   String
  key       String
  result    Json?
  createdAt DateTime @default(now())

  @@unique([actorId, key])
  @@index([createdAt])
  @@map("notification_idempotency_key")
}

// ─────────────────────────────────────────────
// Own-notification controls (NF-07 to NF-09, NF-20 to NF-22)
// ─────────────────────────────────────────────

/// One row per user while snoozed. Non-security notifications still land in the inbox
/// but are not sent by push, email or SMS until `until` passes.
model NotificationSnooze {
  id        String   @id @default(uuid())
  userId    String   @unique
  until     DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([until])
  @@map("notification_snooze")
}

/// One mute system for every record type (replaces per-report and per-post mutes).
model NotificationEntityMute {
  id        String   @id @default(uuid())
  userId    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entity, entityId])
  @@index([entity, entityId])
  @@map("notification_entity_mute")
}

// ─────────────────────────────────────────────
// Delivery operations (NF-40, NF-41, NF-59 to NF-63)
// ─────────────────────────────────────────────

/// Addresses and numbers a provider reported as bounced or blocked.
/// channel: EMAIL | SMS. status: ACTIVE | CLEARED.
/// address is stored normalised (lower-case email, digits-only phone) and is masked in every API response.
model NotificationBounce {
  id             String    @id @default(uuid())
  channel        String
  address        String
  userId         String?
  reason         String
  providerCode   String?
  status         String    @default("ACTIVE")
  bounceCount    Int       @default(1)
  firstBouncedAt DateTime  @default(now())
  lastBouncedAt  DateTime  @default(now())
  clearedAt      DateTime?
  clearedById    String?
  clearNote      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([channel, address])
  @@index([status, lastBouncedAt])
  @@index([userId])
  @@map("notification_bounce")
}

/// Small key/value store for admin-changed settings. Key used today: 'retention'.
model NotificationSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("notification_setting")
}

/// One row per outside channel that has ever been paused. channel: EMAIL | SMS | PUSH.
model NotificationQueueState {
  channel     String    @id
  paused      Boolean   @default(false)
  reason      String?
  pausedAt    DateTime?
  pausedById  String?
  resumedAt   DateTime?
  resumedById String?
  updatedAt   DateTime  @default(now()) @updatedAt

  @@map("notification_queue_state")
}