// Notification model needs the matching relation fields (broadcastId, broadcast, deliveries)

model NotificationPreference {
  id              String           @id @default(uuid())
  userId          String
  type            NotificationType
  email           Boolean?
  sms             Boolean?
  push            Boolean?
  quietHoursStart String?
  quietHoursEnd   String?
  timezone        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("notification_preference")
}

// Statuses are plain strings so the queue claim can use simple raw SQL
model NotificationDelivery {
  id             String    @id @default(uuid())
  notificationId String
  userId         String
  channel        String
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([channel, status])
  @@map("notification_delivery")
}

// FIX: was missing a @relation to User — userId was a bare scalar with no FK,
// so DeviceToken rows were never cascade-deleted and could outlive their user.
model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_token")
}

model NotificationBroadcast {
  id             String               @id @default(uuid())
  createdById    String?
  audience       String
  type           NotificationType
  title          String
  body           String
  priority       NotificationPriority @default(NORMAL)
  templateId     String?
  status         String               @default("SCHEDULED")
  scheduledAt    DateTime             @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  recipientCount Int                  @default(0)
  attempts       Int                  @default(0)
  error          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt

  notifications Notification[]

  @@index([status, scheduledAt])
  @@index([createdById, createdAt])
  @@map("notification_broadcast")
}

model NotificationTemplate {
  id          String           @id @default(uuid())
  type        NotificationType
  language    String
  title       String
  body        String
  isActive    Boolean          @default(true)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  @@unique([type, language])
  @@map("notification_template")
}

model NotificationIdempotencyKey {
  id        String   @id @default(uuid())
  actorId   String
  key       String
  result    Json?
  createdAt DateTime @default(now())

  @@unique([actorId, key])
  @@index([createdAt])
  @@map("notification_idempotency_key")
}