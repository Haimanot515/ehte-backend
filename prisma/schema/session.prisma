// ─────────────────────────────────────────────
// AUTHENTICATION — Session
// ─────────────────────────────────────────────

model Session {
  id     String @id @default(uuid())
  userId String

  refreshToken String
  expiresAt    DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}
