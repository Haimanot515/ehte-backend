// Sign-in history for admin login history and login stats (AR-28, AR-78).
// Written for every admin/user login attempt, including failures and lockouts.
// Keep ipAddress and userAgent out of any message a third party could read (discreet mode).
model LoginAttempt {
  id            String             @id @default(uuid())
  userId        String?
  // What was typed (email or phone), so failed attempts for unknown accounts still show up.
  identifier    String
  result        LoginResultEnum
  failureReason String?
  ipAddress     String?
  userAgent     String?
  deviceLabel   String?
  country       String?
  city          String?
  createdAt     DateTime           @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([result, createdAt])
  @@index([createdAt])
  @@map("login_attempt")
}

enum LoginResultEnum {
  SUCCESS
  FAILED
  LOCKED
  TWO_FACTOR_REQUIRED
}
