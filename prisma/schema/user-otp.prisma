// user-otp.prisma
// Every existing field/relation reproduced as-is. Only addition:
// phone_change on UserOtpPurposeEnum, for UserService's change-phone flow.

model UserOtp {
  id        String             @id @default(uuid())
  userId    String
  purpose   UserOtpPurposeEnum
  otpHash   String
  expiresAt DateTime
  attempts  Int                @default(0)
  usedAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  channel   OtpChannelEnum     @default(sms)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("user_otps")
}

enum UserOtpPurposeEnum {
  email_verification
  phone_verification
  password_reset
  password_change
  login_2fa
  admin_verification
  admin_invite_activation
  promotion_verification
  phone_change
}

enum OtpChannelEnum {
  sms
  email
}