model VictimProfile {
  id                    String              @id @default(uuid())
  name                  String?
  description           String?
  story                 String?
  supportType           SupportType?
  supportGoal           Decimal?            @db.Decimal(12, 2)
  photo                 String[]
  video                 String[]
  audio                 String[]
  pdf                   String[]
  document              String[]
  other                 String[]
  involvesChild         Boolean             @default(false)
  status                VictimProfileStatus @default(PENDING)
  isVerified            Boolean             @default(false)
  isSafetyReviewed      Boolean             @default(false)
  hasConsent            Boolean             @default(false)
  consentAt             DateTime?
  consentRecordedBy     String?
  isPrivacyReviewed     Boolean             @default(false)
  isAdminApproved       Boolean             @default(false)
  isPublished           Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  bankAccountName       String?
  bankAccountNumber     String?
  bankName              String?
  isChildSafetyReviewed Boolean             @default(false)
  supports              Support[]

  // Which admin created this profile (item #5/#26 scoping, and
  // generally useful for audit — nothing previously recorded who
  // authored a profile).
  createdByUserId String?

  // Duplicate-submission protection (item #5), mirrors
  // Report/Post/MissingPerson.idempotencyKey, but scoped to the
  // creating admin rather than a "submitter" (this model has none).
  idempotencyKey String?

  // Running total of attached-media bytes (item #13).
  mediaTotalBytes Int @default(0)

  // Self-serve admin claim (item #17), mirrors Post's
  // claimedByUserId/claimedAt.
  claimedByUserId String?
  claimedAt       DateTime?

  // Child-safety dual control (item #16). Only meaningful when
  // involvesChild = true. Mirrors Post's
  // childSafetyFirstConfirmedByUserId/At.
  childSafetyFirstConfirmedByUserId String?
  childSafetyFirstConfirmedAt       DateTime?

  // Cached running total of confirmed money collected for this
  // profile. Kept in sync incrementally by SupportService.updateStatus
  // (only Support rows with status === CONFIRMED count — see that
  // file's header comment), never client-writable (absent from
  // Create/UpdateVictimProfileDto), and periodically checked against
  // a live SUM() over Support by VictimProfileService.reconcileProfileTotal /
  // reconcileAllTotals.
  totalRaised Decimal @default(0) @db.Decimal(12, 2)

  @@unique([createdByUserId, idempotencyKey])
  @@index([status])
  @@index([involvesChild])
  // Supports findStalePending()'s cutoff query (item #15).
  @@index([status, createdAt])
  @@map("victim_profile")
}

enum VictimProfileStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  CONSENT_PENDING
  APPROVED
  PUBLISHED
  REJECTED
  UNPUBLISHED
}