model VictimProfile {
  id                    String              @id @default(uuid())
  name                  String?
  description           String?
  story                 String?
  supportType           SupportType?
  supportGoal           Decimal?            @db.Decimal(12, 2)
  photo                 String[]
  video                 String[]
  audio                 String[]
  pdf                   String[]
  document              String[]
  other                 String[]
  involvesChild         Boolean             @default(false)
  status                VictimProfileStatus @default(PENDING)
  isVerified            Boolean             @default(false)
  isSafetyReviewed      Boolean             @default(false)
  hasConsent            Boolean             @default(false)
  consentAt             DateTime?
  consentRecordedBy     String?
  isPrivacyReviewed     Boolean             @default(false)
  isAdminApproved       Boolean             @default(false)
  isPublished           Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  bankAccountName       String?
  bankAccountNumber     String?
  bankName              String?
  isChildSafetyReviewed Boolean             @default(false)
  supports              Support[]

  createdByUserId String?

  // Scoped to the creating admin, NULL keys never conflict
  idempotencyKey String?

  mediaTotalBytes Int @default(0)

  claimedByUserId String?
  claimedAt       DateTime?

  childSafetyFirstConfirmedByUserId String?
  childSafetyFirstConfirmedAt       DateTime?

  // Cached total of CONFIRMED support, never client-writable
  totalRaised Decimal @default(0) @db.Decimal(12, 2)

  // Added for Chapa billing: the active agreement VERSION that governs the
  // support split for this profile (PRD §22 — split depends on the agreement
  // per case). Only settable while isPublished = false (see AgreementService.
  // assignToProfile in SUPPORT_INTEGRATION.md §9). A profile with no
  // agreementId cannot receive support — AllocationService.preview() rejects it.
  agreementId String?

  @@unique([createdByUserId, idempotencyKey])
  @@index([status])
  @@index([involvesChild])
  @@index([status, createdAt])
  @@map("victim_profile")
}

enum VictimProfileStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  CONSENT_PENDING
  APPROVED
  PUBLISHED
  REJECTED
  UNPUBLISHED
}