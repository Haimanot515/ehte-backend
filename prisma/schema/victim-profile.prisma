model VictimProfile {
  id                    String              @id @default(uuid())
  name                  String?
  description           String?
  story                 String?
  supportType           SupportType?
  supportGoal           Decimal?            @db.Decimal(12, 2)
  photo                 String[]
  video                 String[]
  audio                 String[]
  pdf                   String[]
  document              String[]
  other                 String[]
  involvesChild         Boolean             @default(false)
  status                VictimProfileStatus @default(PENDING)
  isVerified            Boolean             @default(false)
  isSafetyReviewed      Boolean             @default(false)
  hasConsent            Boolean             @default(false)
  consentAt             DateTime?
  consentRecordedBy     String?
  isPrivacyReviewed     Boolean             @default(false)
  isAdminApproved       Boolean             @default(false)
  isPublished           Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  bankAccountName       String?
  bankAccountNumber     String?
  bankName              String?
  isChildSafetyReviewed Boolean             @default(false)
  supports              Support[]

  @@index([status])
  @@index([involvesChild])
  @@map("victim_profile")
}

enum VictimProfileStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  CONSENT_PENDING
  APPROVED
  PUBLISHED
  REJECTED
  UNPUBLISHED
}
