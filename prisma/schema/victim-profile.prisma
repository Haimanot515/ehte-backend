model VictimProfile {
  id                    String              @id @default(uuid())
  name                  String?
  description           String?
  story                 String?
  supportType           SupportType?
  supportGoal           Decimal?            @db.Decimal(12, 2)
  photo                 String[]
  video                 String[]
  audio                 String[]
  pdf                   String[]
  document              String[]
  other                 String[]
  involvesChild         Boolean             @default(false)
  status                VictimProfileStatus @default(PENDING)
  isVerified            Boolean             @default(false)
  isSafetyReviewed      Boolean             @default(false)
  hasConsent            Boolean             @default(false)
  consentAt             DateTime?
  consentRecordedBy     String?
  isPrivacyReviewed     Boolean             @default(false)
  isAdminApproved       Boolean             @default(false)
  isPublished           Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  bankAccountName       String?
  bankAccountNumber     String?
  bankName              String?
  isChildSafetyReviewed Boolean             @default(false)
  supports              Support[]

  // NEW — which admin created this profile (item #5/#26 scoping,
  // and generally useful for audit — nothing previously recorded
  // who authored a profile).
  createdByUserId String?

  // NEW — duplicate-submission protection (item #5), mirrors
  // Report/Post/MissingPerson.idempotencyKey, but scoped to the
  // creating admin rather than a "submitter" (this model has none).
  idempotencyKey String?

  // NEW — running total of attached-media bytes (item #13).
  mediaTotalBytes Int @default(0)

  // NEW — self-serve admin claim (item #17), mirrors Post's
  // claimedByUserId/claimedAt.
  claimedByUserId String?
  claimedAt       DateTime?

  // NEW — child-safety dual control (item #16). Only meaningful
  // when involvesChild = true. Mirrors Post's
  // childSafetyFirstConfirmedByUserId/At.
  childSafetyFirstConfirmedByUserId String?
  childSafetyFirstConfirmedAt       DateTime?

  @@unique([createdByUserId, idempotencyKey])
  @@index([status])
  @@index([involvesChild])
  // NEW — supports findStalePending()'s cutoff query (item #15).
  @@index([status, createdAt])
  @@map("victim_profile")
}

enum VictimProfileStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  CONSENT_PENDING
  APPROVED
  PUBLISHED
  REJECTED
  UNPUBLISHED
}