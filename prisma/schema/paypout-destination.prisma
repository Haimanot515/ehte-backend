enum PayoutRail {
  BANK
  TELEBIRR
}

// Financial Account (section 18 / 24): where a recipient's allocated money is paid.
// Deliberately separate from Agreement (which defines who gets what share) and from
// payment-provider configuration (which is platform-side, not tied to one recipient).
model PayoutDestination {
  id            String     @id @default(uuid())
  rail          PayoutRail
  bankName      String?
  // GAP 4 FIX (G4): Chapa's bank code for this destination's bankName,
  // validated against ChapaService.getBanks() at write time
  // (victim-profile.service.ts) and re-validated at payout time
  // (disbursement.service.ts's transferOrReconcile()), since the list can
  // change between when someone entered bank details and when a payout
  // actually runs.
  bankCode      String?
  accountNumber String?
  telebirrPhone String?
  accountHolder String
  country       String     @default("ET")
  currency      String     @default("ETB")
  isVerified    Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  institutionId   String?
  victimProfileId String?    @unique // was: String?

  institution   Institution?   @relation(fields: [institutionId], references: [id])
  victimProfile VictimProfile? @relation(fields: [victimProfileId], references: [id])
  disbursements Disbursement[]

  @@index([institutionId])
  // removed @@index([victimProfileId]); @unique already creates the index
  @@map("payout_destinations")
}

model Disbursement {
  id                  String             @id @default(uuid())
  allocationId        String
  // Set only for REWARD_BENEFICIARY disbursements against a split reward pool
  // allocation: which informant's approved RewardClaim this specific payout is for.
  // Lets one PaymentAllocation be paid out across several disbursements (section 12) —
  // execute()/markPaidOut() total the claim's own disbursements against
  // rewardClaim.rewardAmount instead of the whole allocation amount.
  rewardClaimId       String?
  payoutDestinationId String?
  method              DisbursementMethod
  status              DisbursementStatus @default(PENDING_APPROVAL)
  amount              Decimal            @db.Decimal(14, 2)
  currency            String             @default("ETB")
  fxRate              Decimal?           @db.Decimal(18, 8)
  reference           String             @unique
  externalReference   String?
  createdById         String
  approvedById        String?
  executedById        String?
  executedAt          DateTime?
  failureReason       String?
  createdAt           DateTime           @default(now())

  // GAP 2 FIX (disbursement idempotency): lets DisbursementService.retry()
  // safely re-attempt a FAILED CHAPA_TRANSFER without ever re-sending blind —
  // see the "GAP 2 FIX" comments in disbursement.service.ts.
  //   retryCount    — capped by config (disbursement.maxRetryAttempts,
  //                   default 3); incremented atomically in the same
  //                   updateMany() that flips FAILED -> PROCESSING, so two
  //                   concurrent retry() calls can't both slip in under the cap.
  //   lastBankCode  — the Chapa bank code used on the most recent transfer
  //                   attempt for this disbursement, so a retry doesn't need
  //                   it re-supplied by the admin. Only meaningful for
  //                   CHAPA_TRANSFER; left null for MANUAL_BANK. Re-validated
  //                   against ChapaService.getBanks() on every send, not just
  //                   trusted as-is (G4).
  retryCount          Int                @default(0)
  lastBankCode        String?

  // Snapshot of PayoutDestination at execution time; the standing record can change later.
  destinationSnapshot Json?

  allocation        PaymentAllocation  @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  rewardClaim       RewardClaim?       @relation(fields: [rewardClaimId], references: [id])
  payoutDestination PayoutDestination? @relation(fields: [payoutDestinationId], references: [id])

  @@index([status])
  @@index([allocationId])
  @@index([rewardClaimId])
  @@map("disbursements")
}