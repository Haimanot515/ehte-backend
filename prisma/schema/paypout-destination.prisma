enum PayoutRail {
  BANK
  TELEBIRR
}

model PayoutDestination {
  id            String     @id @default(uuid())
  rail          PayoutRail
  bankName      String?
  // Chapa bank id used as bank_code in transfers; set from chapa.getBanks(), never typed per payout.
  bankCode      String?
  accountNumber String?
  telebirrPhone String?
  accountHolder String
  country       String     @default("ET")
  currency      String     @default("ETB")
  isVerified    Boolean    @default(false)

  lastEditedById String?
  verifiedById   String?
  verifiedAt     DateTime?
  verifiedNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institutionId   String?
  victimProfileId String? @unique

  institution   Institution?   @relation(fields: [institutionId], references: [id])
  victimProfile VictimProfile? @relation(fields: [victimProfileId], references: [id])
  disbursements Disbursement[]

  @@index([institutionId])
  @@map("payout_destinations")
}

model Disbursement {
  id                  String             @id @default(uuid())
  allocationId        String
  rewardClaimId       String?
  payoutDestinationId String?
  method              DisbursementMethod
  status              DisbursementStatus @default(PENDING_APPROVAL)
  amount              Decimal            @db.Decimal(14, 2)
  currency            String             @default("ETB")
  fxRate              Decimal?           @db.Decimal(18, 8)
  reference           String             @unique
  externalReference   String?
  createdById         String
  approvedById        String?
  executedById        String?
  executedAt          DateTime?
  failureReason       String?
  createdAt           DateTime           @default(now())

  heldAt     DateTime?
  holdReason String?
  heldById   String?

  // Snapshot of PayoutDestination at execution time; the standing record can change later
  destinationSnapshot Json?

  allocation        PaymentAllocation  @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  rewardClaim       RewardClaim?       @relation(fields: [rewardClaimId], references: [id])
  payoutDestination PayoutDestination? @relation(fields: [payoutDestinationId], references: [id])
  createdBy         User               @relation("DisbursementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy        User?              @relation("DisbursementApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  executedBy        User?              @relation("DisbursementExecutedBy", fields: [executedById], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([allocationId])
  @@index([rewardClaimId])
  @@map("disbursements")
}