model ProviderEvent {
  id                String    @id @default(uuid())
  provider          String
  kind              String
  eventId           String?
  providerMessageId String?
  eventType         String?
  payload           Json
  signatureValid    Boolean   @default(true)
  result            String
  error             String?
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@index([result])
  @@index([providerMessageId])
  @@map("provider_event")
}
