model MissingPerson {
  id                     String                  @id @default(uuid())
  userId                 String
  personType             MissingPersonType
  name                   String?
  description            String
  dateLastSeen           DateTime
  lastKnownArea          String
  photo                  String[]
  video                  String[]
  audio                  String[]
  pdf                    String[]
  document               String[]
  other                  String[]
  status                 MissingPersonStatus     @default(PENDING)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  childSafetyConfirmed   Boolean                 @default(false)
  reviewNote             String?
  rewardAmount           Int?
  rewardApproved         Boolean                 @default(false)
  rewardDetails          String?
  rewardOffered          Boolean                 @default(false)
  informationSubmissions InformationSubmission[]
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([personType])
  @@map("missing_person")
}

enum MissingPersonType {
  WOMAN
  CHILD
}

enum MissingPersonStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  FOUND
  MORE_INFORMATION_REQUESTED
}
