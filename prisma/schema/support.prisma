model Support {
  id                 String               @id @default(uuid())
  victimProfileId    String
  userId             String?
  type               SupportType          @default(FINANCIAL)
  status             SupportStatus        @default(PENDING)
  agreementType      SupportAgreementType @default(DIRECT)
  amount             Decimal?             @db.Decimal(12, 2)
  recipientAmount    Decimal?             @db.Decimal(12, 2)
  organizationAmount Decimal?             @db.Decimal(12, 2)
  platformAmount     Decimal?             @db.Decimal(12, 2)
  message            String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  transferReference  String?
  user               User?                @relation(fields: [userId], references: [id])
  victimProfile      VictimProfile        @relation(fields: [victimProfileId], references: [id], onDelete: Cascade)

  @@index([victimProfileId])
  @@index([userId])
  @@index([status])
  @@map("support")
}

enum SupportType {
  FINANCIAL
  NON_FINANCIAL
  OTHER
}

enum SupportStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  FAILED
}

enum SupportAgreementType {
  DIRECT
  PARTNER_ORGANIZATION
  INSTITUTIONAL
}
