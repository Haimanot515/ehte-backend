enum AgreementStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum RuleMode {
  PERCENT_BPS
  FLAT
}

model Agreement {
  id            String               @id @default(uuid())
  type          SupportAgreementType
  institutionId String?
  version       Int                  @default(1)
  status        AgreementStatus      @default(DRAFT)
  currency      String               @default("ETB")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  approvedById  String?
  createdAt     DateTime             @default(now())

  refundPolicy       String?
  cancellationPolicy String?

  retirementReason String?
  retiredById      String?
  retiredAt        DateTime?

  institution    Institution?     @relation(fields: [institutionId], references: [id])
  rules          AllocationRule[]
  payments       Payment[]
  supports       Support[]
  victimProfiles VictimProfile[]
  missingPersons MissingPerson[]
  rewardClaims   RewardClaim[]
  approvedBy     User?            @relation("AgreementApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  retiredBy      User?            @relation("AgreementRetiredBy", fields: [retiredById], references: [id], onDelete: SetNull)

  @@unique([type, institutionId, version])
  @@map("agreements")
}

model AllocationRule {
  id            String      @id @default(uuid())
  agreementId   String
  paymentType   PaymentType
  partyType     PartyType
  institutionId String?
  mode          RuleMode
  valueBps      Int?
  flatAmount    Decimal?    @db.Decimal(14, 2)

  agreement   Agreement    @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  institution Institution? @relation(fields: [institutionId], references: [id])
  allocations PaymentAllocation[]

  @@index([agreementId, paymentType])
  @@map("allocation_rules")
}
