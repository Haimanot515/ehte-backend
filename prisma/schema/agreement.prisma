enum AgreementStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum RuleMode {
  PERCENT_BPS
  FLAT
}

model Agreement {
  id            String               @id @default(uuid())
  type          SupportAgreementType
  institutionId String?
  version       Int                  @default(1)
  status        AgreementStatus      @default(DRAFT)
  currency      String               @default("ETB")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  approvedById  String?
  createdAt     DateTime             @default(now())

  // Section 14 / 27 / 28: policies are attached to the agreement version they were
  // accepted under, not edited in place — a new agreement version is required to
  // change them, same as any other commercial term.
  refundPolicy       String?
  cancellationPolicy String?

  // Section 3 / 28: retirement must capture a reason and be attributable; an
  // impact review (assigned/published profiles, pending payments, open reward
  // cases) is computed on demand by AgreementService.retire() rather than stored,
  // since it is a point-in-time report, not a fact about the agreement itself.
  retirementReason String?
  retiredById      String?
  retiredAt        DateTime?

  institution    Institution?     @relation(fields: [institutionId], references: [id])
  rules          AllocationRule[]
  payments       Payment[]
  supports       Support[]
  victimProfiles VictimProfile[]
  missingPersons MissingPerson[]

  // @@unique below turns concurrent createDraft() version races into a P2002 that
  // AgreementService.createAgreementWithUniqueVersion() catches and retries on.
  @@unique([type, institutionId, version])
  @@map("agreements")
}

// RuleLines. A rule's paymentType determines which financial direction it belongs
// to (section 33): SUPPORT = Victim Profile Payment allocation, MISSING_PERSON_REWARD
// = Reward allocation, *_POSTING_FEE = Posting/Promotion Fee allocation. Keeping them
// as PaymentType variants (rather than a separate "businessDomain" column) means
// AllocationService's existing per-paymentType rule lookup already isolates the three
// directions without extra branching.
model AllocationRule {
  id            String      @id @default(uuid())
  agreementId   String
  paymentType   PaymentType
  partyType     PartyType
  institutionId String?
  mode          RuleMode
  valueBps      Int?
  flatAmount    Decimal?    @db.Decimal(14, 2)

  agreement   Agreement    @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  institution Institution? @relation(fields: [institutionId], references: [id])

  // RECIPIENT (support) / REWARD_BENEFICIARY-as-remainder (reward pool) is never
  // stored as a rule: it is always total - sum(other rules) for that paymentType.
  @@index([agreementId, paymentType])
  @@map("allocation_rules")
}
