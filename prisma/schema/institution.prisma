enum InstitutionStatus {
  PROSPECT
  AGREEMENT_SIGNED
  SUSPENDED
}

model Institution {
  id        String            @id @default(uuid())
  name      String
  status    InstitutionStatus @default(PROSPECT)
  signedAt  DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  agreements         Agreement[]
  allocationRules    AllocationRule[]
  allocations        PaymentAllocation[]
  payoutDestinations PayoutDestination[]

  // Only AGREEMENT_SIGNED institutions may be shown as partners or as RESPONSIBLE_ORGANIZATION.
  @@map("institutions")
}