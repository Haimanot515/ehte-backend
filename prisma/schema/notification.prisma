model Notification {
  id        String           @id @default(uuid())
  userId    String?
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([type])
  @@map("notification")
}

enum NotificationType {
  GENERAL
  REPORT_RECEIVED
  REPORT_UPDATED
  MORE_INFORMATION_REQUESTED
  POST_APPROVED
  POST_REJECTED
  MISSING_PERSON_UPDATED
  NEW_MISSING_PERSON_INFORMATION
  SUPPORT_PAYMENT_CONFIRMED
  NEW_REPORT
  HIGH_PRIORITY_REPORT
  NEW_POST
  NEW_MISSING_PERSON_REQUEST
  SECURITY_ALERT
  PASSWORD_CHANGED
  PASSWORD_RESET

  // NEW — added to fix NotificationListener compile errors (these
  // values were referenced by the listener but never existed in the
  // enum). Run `npx prisma migrate dev` (or `db push` + `generate`
  // for a shared/prod DB) after adding these.
  REPORT_ASSIGNED
  INFORMATION_REQUEST_RESPONDED
  POST_CHANGES_REQUESTED
  POST_UNPUBLISHED
  MISSING_PERSON_APPROVED
  MISSING_PERSON_REJECTED
  MISSING_PERSON_FOUND
  MISSING_PERSON_MORE_INFORMATION_REQUESTED

  // NEW — added alongside the VictimProfileService audit/notification
  // fix (see NotificationListener's VICTIM PROFILE section). These 11
  // are referenced by NotificationListener's handleVictimProfile*
  // methods, which previously would have thrown at runtime — Prisma
  // rejects any `type` value not in this enum — the moment any of
  // those handlers fired. claim/unclaim/media-download/child-safety-
  // first-confirm are deliberately excluded: they're audit-only, with
  // no paired notification, per NotificationEventEnum's own comment.
  VICTIM_PROFILE_CREATED
  VICTIM_PROFILE_UPDATED
  VICTIM_PROFILE_DELETED
  VICTIM_PROFILE_GATES_UPDATED
  VICTIM_PROFILE_CHILD_SAFETY_REVIEWED
  VICTIM_PROFILE_CONSENT_REVOKED
  VICTIM_PROFILE_BANK_DETAILS_UPDATED
  VICTIM_PROFILE_PUBLISHED
  VICTIM_PROFILE_UNPUBLISHED
  VICTIM_PROFILE_REJECTED
  VICTIM_PROFILE_RESUBMITTED

  // NEW — InformationSubmissionService.review() emits
  // NotificationEventEnum.INFORMATION_SUBMISSION_REVIEWED /
  // ...REJECTED correctly (dynamic enum reference, not a raw
  // string), but NotificationListener had no @OnEvent() handler
  // for either and this enum had no matching member — so both
  // silently dropped at the listener/type level, same failure
  // mode as the VictimProfile gap above, just one call site
  // instead of eighteen.
  INFORMATION_SUBMISSION_REVIEWED
  INFORMATION_SUBMISSION_REJECTED
}