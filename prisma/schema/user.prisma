model User {
  id                       String                     @id @default(uuid())
  name                     String?
  phone                    String?                    @unique
  isActive                 Boolean                    @default(true)
  discreetModeEnabled      Boolean                    @default(false)
  discreetModeUpdatedAt    DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  isPhoneVerified          Boolean                    @default(false)
  failedLoginAttempts      Int                        @default(0)
  lockedUntil              DateTime?
  discreetModePasscodeHash String?
  passwordHash             String?
  email                    String?                    @unique
  inviteTokenExpiresAt     DateTime?
  inviteTokenHash          String?                    @unique
  isEmailVerified          Boolean                    @default(false)
  auditLogs                AuditLog[]
  informationReports       InformationSubmission[]
  missingPersons           MissingPerson[]
  notifications            Notification[]
  posts                    Post[]
  assignedReports          Report[]                   @relation("ReportAssignee")
  reports                  Report[]                   @relation("ReportReporter")
  requestedInformation     ReportInformationRequest[] @relation("InfoRequestRequestedBy")
  sessions                 Session[]
  supports                 Support[]
  otps                     UserOtp[]
  userRoles                UserRole[]

  @@map("user")
}
