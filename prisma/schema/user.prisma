// user.prisma
// Every existing field/relation reproduced as-is. Profile/address fields
// moved to UserProfile (see user-profile.prisma) — only pendingPhone
// (part of the auth/verification flow, not "profile" data) stays here.

model User {
  id                       String                     @id @default(uuid())
  name                     String?
  phone                    String?                    @unique
  isActive                 Boolean                    @default(true)
  discreetModeEnabled      Boolean                    @default(false)
  discreetModeUpdatedAt    DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  isPhoneVerified          Boolean                    @default(false)
  failedLoginAttempts      Int                        @default(0)
  lockedUntil              DateTime?
  discreetModePasscodeHash String?
  passwordHash             String?
  email                    String?                    @unique
  inviteTokenExpiresAt     DateTime?
  inviteTokenHash          String?                    @unique
  isEmailVerified          Boolean                    @default(false)

  // Holds a not-yet-verified new phone during change-phone flow; not unique.
  pendingPhone             String?

  auditLogs                AuditLog[]
  informationReports       InformationSubmission[]
  missingPersons           MissingPerson[]
  notifications            Notification[]
  posts                    Post[]
  assignedReports          Report[]                   @relation("ReportAssignee")
  reports                  Report[]                   @relation("ReportReporter")
  requestedInformation     ReportInformationRequest[] @relation("InfoRequestRequestedBy")
  sessions                 Session[]
  supports                 Support[]
  otps                     UserOtp[]
  userRoles                UserRole[]
  // NEW — inverse side of UserRole.assignedByUser. Lets you query
  // "which role grants did this user make" (e.g. user.assignedRoles).
  assignedRoles            UserRole[]                 @relation("UserRoleAssignedBy")

  // NEW — one-to-one, optional. Row is created lazily on first profile
  // edit (see UserService.updateMe's upsert), not at signup time.
  profile                  UserProfile?

  @@map("user")
}