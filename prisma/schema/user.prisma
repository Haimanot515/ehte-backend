// Holds a not-yet-verified new phone during the change-phone flow
model User {
  id                       String    @id @default(uuid())
  name                     String?
  phone                    String?   @unique
  isActive                 Boolean   @default(true)
  discreetModeEnabled      Boolean   @default(false)
  discreetModeUpdatedAt    DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  isPhoneVerified          Boolean   @default(false)
  failedLoginAttempts      Int       @default(0)
  lockedUntil              DateTime?
  discreetModePasscodeHash String?
  passwordHash             String?
  email                    String?   @unique
  inviteTokenExpiresAt     DateTime?
  inviteTokenHash          String?   @unique
  isEmailVerified          Boolean   @default(false)

  // Social login — one nullable+unique column per provider, same pattern as
  // the rest of this model. NULL is fine on all three for local (phone/
  // password) accounts; Postgres unique indexes allow multiple NULLs.
  googleId   String? @unique
  facebookId String? @unique
  appleId    String? @unique

  pendingPhone String?

  auditLogs            AuditLog[]
  informationReports   InformationSubmission[]
  missingPersons       MissingPerson[]
  notifications        Notification[]
  posts                Post[]
  assignedReports      Report[]                   @relation("ReportAssignee")
  reports              Report[]                   @relation("ReportReporter")
  requestedInformation ReportInformationRequest[] @relation("InfoRequestRequestedBy")
  sessions             Session[]
  supports             Support[]
  payments             Payment[]
  otps                 UserOtp[]
  userRoles            UserRole[]
  assignedRoles        UserRole[]                 @relation("UserRoleAssignedBy")

  // FIX: added to match the new @relation on DeviceToken/NotificationPreference
  // in notification-delivery.prisma — both sides required for a Prisma relation.
  deviceTokens            DeviceToken[]
  notificationPreferences NotificationPreference[]

  profile UserProfile?

  @@map("user")
}