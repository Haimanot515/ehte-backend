model User {
  id   String  @id @default(uuid())
  name String?

  // FIX: was `phone String @unique` (required). AuthService.adminInvite()
  // creates admins with email only and no phone at all (by design — see
  // adminActivateSelf()'s "Admin has no phone at this point" comment and
  // issueTokens() treating phone/email as independently-optional identity
  // fields). A required @unique string can't be omitted from a create()
  // call, which is exactly what was breaking. Nullable @unique columns
  // allow any number of NULLs in Postgres, so multiple phone-less admins
  // can coexist without violating uniqueness.
  phone        String? @unique
  passwordHash String?
  isActive     Boolean @default(true)

  isPhoneVerified Boolean @default(false)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Email + Email-OTP admin channel (invite, activation, promotion, admin login-by-email)
  email                String?   @unique
  isEmailVerified      Boolean   @default(false)
  inviteTokenHash      String?   @unique
  inviteTokenExpiresAt DateTime?

  // Discreet Mode state (Section 9.1 / 9.5).
  // Toggling this requires re-authentication at the application layer
  // (either the normal account password, or — if already enabled —
  // the existing Discreet Mode passcode). See UserService.updateDiscreetMode().
  discreetModeEnabled      Boolean   @default(false)
  discreetModePasscodeHash String?
  discreetModeUpdatedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otps          UserOtp[]
  sessions      Session[]
  userRoles     UserRole[]
  auditLogs     AuditLog[]
  notifications Notification[]

  reports         Report[] @relation("ReportReporter")
  assignedReports Report[] @relation("ReportAssignee")

  requestedInformation ReportInformationRequest[] @relation("InfoRequestRequestedBy")

  posts              Post[]
  missingPersons     MissingPerson[]
  informationReports InformationSubmission[]
  supports           Support[]

  @@map("user")
}