enum RewardClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  VALID
  INVALID
  DUPLICATE
  ALREADY_KNOWN
  INELIGIBLE
  APPROVED_FOR_REWARD
  REJECTED
  PAID_OUT
  REFUND_DUE
  REFUNDED
}

model RewardClaim {
  id                      String  @id @default(uuid())
  missingPersonId         String
  informationSubmissionId String?
  informantUserId         String?

  status RewardClaimStatus @default(SUBMITTED)

  timeScore         Int?
  evidenceScore     Int?
  credibilityScore  Int?
  timeWeight        Int?
  evidenceWeight    Int?
  credibilityWeight Int?
  weightedScore     Decimal? @db.Decimal(6, 2)

  rewardPercentage Decimal? @db.Decimal(5, 2)
  rewardAmount     Decimal? @db.Decimal(14, 2)

  agreementId      String?
  agreementVersion Int?

  duplicateOfClaimId String?

  decisionReason String?
  reviewedById   String?
  reviewedAt     DateTime?

  approvedById String?
  approvedAt   DateTime?
  closedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  missingPerson MissingPerson       @relation(fields: [missingPersonId], references: [id], onDelete: Cascade)
  disbursements Disbursement[]
  appeals       RewardClaimAppeal[]

  informationSubmission InformationSubmission? @relation(fields: [informationSubmissionId], references: [id], onDelete: SetNull)
  informantUser         User?                  @relation("RewardClaimInformant", fields: [informantUserId], references: [id], onDelete: SetNull)
  agreement             Agreement?             @relation(fields: [agreementId], references: [id])
  duplicateOfClaim      RewardClaim?           @relation("RewardClaimDuplicate", fields: [duplicateOfClaimId], references: [id], onDelete: SetNull)
  duplicateClaims       RewardClaim[]          @relation("RewardClaimDuplicate")
  reviewedBy            User?                  @relation("RewardClaimReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  approvedBy            User?                  @relation("RewardClaimApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([missingPersonId, informationSubmissionId])
  @@index([missingPersonId, status])
  @@index([informantUserId])
  @@map("reward_claims")
}
