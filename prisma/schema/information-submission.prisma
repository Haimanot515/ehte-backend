model InformationSubmission {
  id              String @id @default(uuid())
  userId          String
  missingPersonId String

  information String
  location    String?

  photo    String[]
  video    String[]
  audio    String[]
  pdf      String[]
  document String[]
  other    String[]

  // Running total of attached media bytes, computed from statObject() results
  mediaTotalBytes Int @default(0)

  status     InformationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  reviewNote String?

  // Per-user duplicate-submission protection, NULL keys never conflict
  idempotencyKey String?

  missingPerson MissingPerson @relation(fields: [missingPersonId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([missingPersonId])
  @@index([status])
  @@index([status, createdAt])
  @@map("information_submission")
}

enum InformationStatus {
  PENDING
  UNDER_REVIEW
  REVIEWED
  REJECTED
}