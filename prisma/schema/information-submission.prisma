enum InformationStatus {
  PENDING
  UNDER_REVIEW
  REVIEWED
  REJECTED
}

model InformationSubmission {
  id              String            @id @default(uuid())
  userId          String?
  missingPersonId String
  channel         SubmissionChannel @default(APP)

  information String
  location    String?

  photo    String[]
  video    String[]
  audio    String[]
  pdf      String[]
  document String[]
  other    String[]

  mediaTotalBytes Int @default(0)

  status     InformationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  reviewNote String?

  idempotencyKey String?

  missingPerson MissingPerson @relation(fields: [missingPersonId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Running total of attached media bytes, computed from statObject() results.
  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([missingPersonId])
  @@index([status])
  @@index([status, createdAt])
  @@map("information_submission")
}