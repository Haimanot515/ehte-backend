model Post {
  id            String     @id @default(uuid())
  userId        String
  title         String?
  content       String
  type          PostType
  status        PostStatus @default(DRAFT)
  photo         String[]
  video         String[]
  audio         String[]
  pdf           String[]
  document      String[]
  other         String[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  involvesChild Boolean    @default(false)
  reviewNote    String?
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([involvesChild])
  @@map("post")
}

enum PostType {
  INCIDENT
  AWARENESS
}

enum PostStatus {
  DRAFT
  PENDING
  APPROVED
  PUBLISHED
  REJECTED
  UNPUBLISHED
  CHANGES_REQUESTED
}
