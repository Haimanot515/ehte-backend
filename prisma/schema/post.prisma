// ─────────────────────────────────────────────
// EHTE FEATURES — Post
//
// Added `reviewNote` — persists the admin's message
// from requestChanges() or reason from reject()
// directly on the row, so GET /posts/me/:id shows the
// owner why without relying on them having caught the
// notification. Previously this only lived in the
// audit log and the notification event payload.
// ─────────────────────────────────────────────

enum PostType {
  INCIDENT
  AWARENESS
}

enum PostStatus {
  DRAFT
  PENDING
  APPROVED
  PUBLISHED
  REJECTED
  UNPUBLISHED
  CHANGES_REQUESTED
}

model Post {
  id     String @id @default(uuid())
  userId String

  title   String?
  content String

  type   PostType
  status PostStatus @default(DRAFT)

  // Flags content involving a child, triggering the additional
  // review required by PRD §32 before it can be approved.
  involvesChild Boolean @default(false)

  // Added — set by requestChanges() (the admin's message) or
  // reject() (the admin's reason). Cleared or overwritten on the
  // next transition into either of those states; not meant as a
  // history log, just "why is this in its current state."
  reviewNote String?

  photo    String[]
  video    String[]
  audio    String[]
  pdf      String[]
  document String[]
  other    String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([involvesChild])
  @@map("post")
}

