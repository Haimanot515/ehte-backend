model Post {
  id            String     @id @default(uuid())
  userId        String
  title         String?
  content       String
  type          PostType
  status        PostStatus @default(DRAFT)
  photo         String[]
  video         String[]
  audio         String[]
  pdf           String[]
  document      String[]
  other         String[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  involvesChild Boolean    @default(false)
  reviewNote    String?

  idempotencyKey String?

  claimedByUserId String?
  claimedAt       DateTime?

  childSafetyFirstConfirmedByUserId String?
  childSafetyFirstConfirmedAt       DateTime?
  mediaTotalBytes                   Int       @default(0)

  ownerSuspendedAt DateTime?

  takedownReason String?
  takedownAt     DateTime?
  takedownById   String?

  user                            User  @relation("PostOwner", fields: [userId], references: [id], onDelete: Cascade)
  claimedByUser                   User? @relation("PostClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  childSafetyFirstConfirmedByUser User? @relation("PostChildSafetyFirst", fields: [childSafetyFirstConfirmedByUserId], references: [id], onDelete: SetNull)

  readStates PostReadState[]
  flags      PostFlag[]
  appeals    PostAppeal[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([involvesChild])
  @@index([claimedByUserId])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([takedownAt])
  @@map("post")
}

enum PostType {
  INCIDENT
  AWARENESS
}

enum PostStatus {
  DRAFT
  PENDING
  APPROVED
  PUBLISHED
  REJECTED
  UNPUBLISHED
  CHANGES_REQUESTED
}

model PostReadState {
  postId  String
  adminId String
  readAt  DateTime @default(now())

  post  Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  admin User @relation("PostReadStateAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  @@id([postId, adminId])
  @@index([adminId])
  @@map("post_read_state")
}

model PostFlag {
  id           String         @id @default(uuid())
  postId       String
  reporterId   String
  reason       String
  details      String?
  status       PostFlagStatus @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  note         String?
  createdAt    DateTime       @default(now())

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User @relation("PostFlagReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId])
  @@index([status, createdAt])
  @@index([postId, status])
  @@map("post_flag")
}

model PostAppeal {
  id           String           @id @default(uuid())
  postId       String
  authorId     String
  target       PostAppealTarget
  message      String
  status       PostAppealStatus @default(OPEN)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime         @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation("PostAppealAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([postId])
  @@index([authorId, createdAt])
  @@map("post_appeal")
}

enum PostFlagStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum PostAppealStatus {
  OPEN
  UPHELD
  OVERTURNED
}

enum PostAppealTarget {
  REJECTION
  TAKEDOWN
}
