model Post {
  id            String     @id @default(uuid())
  userId        String
  title         String?
  content       String
  type          PostType
  status        PostStatus @default(DRAFT)
  photo         String[]
  video         String[]
  audio         String[]
  pdf           String[]
  document      String[]
  other         String[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  involvesChild Boolean    @default(false)
  reviewNote    String?

  // Per-user duplicate-submission protection, NULL keys never conflict
  idempotencyKey String?

  claimedByUserId String?
  claimedAt       DateTime?

  // Child-safety dual control, a second distinct admin must confirm
  childSafetyFirstConfirmedByUserId String?
  childSafetyFirstConfirmedAt       DateTime?
  mediaTotalBytes                   Int       @default(0)

  ownerSuspendedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([involvesChild])
  @@index([claimedByUserId])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@map("post")
}

enum PostType {
  INCIDENT
  AWARENESS
}

enum PostStatus {
  DRAFT
  PENDING
  APPROVED
  PUBLISHED
  REJECTED
  UNPUBLISHED
  CHANGES_REQUESTED
}