// user-profile.prisma
// One row per user, created lazily on first profile edit — most users
// will have no row until they fill in an address/demographic field.

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Address (Ethiopian administrative hierarchy) — free-text, all optional.
  region  String?
  zone    String?
  city    String?
  subCity String?
  woreda  String?
  kebele  String?

  // Standard profile fields
  preferredLanguage String?
  dateOfBirth       DateTime?
  gender            String?
  alternatePhone    String?
  occupation        String?

  // MinIO object key, not a public URL — read via a presigned-URL endpoint.
  profilePictureUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profile")
}